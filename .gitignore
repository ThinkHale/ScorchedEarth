node_modules/
.env
dist/

# iOS — ignore generated build artifacts and downloaded pods, not the project itself
ios/App/Pods/
ios/App/.build/
ios/App/DerivedData/

# Android — ignore build outputs, not the project itself
android/.gradle/
android/app/build/
android/build/

# Signing secrets — never commit these
*.jks
*.keystore
android/key.properties

# Release artifacts — large binaries, not for source control
*.aab
*.apk
